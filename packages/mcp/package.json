{
  "name": "@point-out/mcp",
  "version": "0.1.0",
  "description": "Local hub and MCP server that hands Pointout comments to any MCP client (Claude Code, Codex, Cursor, Cline) and brings the replies back into your app.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himato/pointout.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Himato/pointout/tree/main/packages/mcp#readme",
  "bugs": "https://github.com/Himato/pointout/issues",
  "keywords": [
    "pointout",
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "feedback",
    "devtools",
    "ai",
    "codex",
    "cursor",
    "cline",
    "coding-agent"
  ],
  "bin": {
    "pointout-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@point-out/core": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  }
}
