{
  "name": "@pointout/core",
  "version": "0.0.0",
  "description": "Click things in your running app, say what is wrong, hand Claude Code a brief it can act on.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:pointout/pointout",
    "directory": "packages/core"
  },
  "keywords": [
    "pointout",
    "feedback",
    "annotation",
    "web-component",
    "claude",
    "claude-code",
    "devtools",
    "ai"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  }
}
