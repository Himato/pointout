{
  "name": "@point-out/core",
  "version": "0.1.0",
  "description": "Click things in your running app, say what is wrong, hand your coding agent (Claude Code, Codex, Cursor) a brief it can act on.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himato/pointout.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Himato/pointout/tree/main/packages/core#readme",
  "bugs": "https://github.com/Himato/pointout/issues",
  "keywords": [
    "pointout",
    "feedback",
    "annotation",
    "web-component",
    "claude",
    "claude-code",
    "devtools",
    "ai",
    "mcp",
    "codex",
    "cursor",
    "coding-agent"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    }
  },
  "typesVersions": {
    "*": {
      "format": [
        "./dist/format.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  }
}
