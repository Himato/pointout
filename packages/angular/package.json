{
  "name": "@point-out/angular",
  "version": "0.1.0",
  "description": "Angular enricher for Pointout. Names the component behind every element you click.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himato/pointout.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/Himato/pointout/tree/main/packages/angular#readme",
  "bugs": "https://github.com/Himato/pointout/issues",
  "keywords": [
    "pointout",
    "angular",
    "feedback",
    "annotation",
    "claude",
    "claude-code",
    "devtools",
    "ai",
    "coding-agent"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js"
    },
    "./always": {
      "types": "./dist/always.d.ts",
      "import": "./dist/always.js"
    }
  },
  "typesVersions": {
    "*": {
      "providers": [
        "./dist/providers.d.ts"
      ],
      "always": [
        "./dist/always.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@angular/core": ">=2.0.0",
    "@angular/router": ">=2.0.0",
    "@point-out/core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@point-out/core": "workspace:^",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  }
}
